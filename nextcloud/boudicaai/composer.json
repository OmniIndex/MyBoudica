{
	"name": "nextcloud/boudicaai",
	"description": "<![CDATA["Black-box" cloud AI models lack transparency and force sensitive information into unpredictable, unauditable third-party frameworks. This creates a massive security gap for regulated industries, where the inability to audit or control the data path leads to intellectual property risks and hallucinated "confidently incorrect" answers that cannot be verified against the data. 

 

Boudica Torc solves this industry wide challenge with truly Sovereign AI.]]>",
	"license": "MIT",
	"authors": [
		{
			"name": "OmniIndex",
			"email": "sibain@omniindex.io",
			"homepage": "https://www.omniindex.io"
		}
	],
	"autoload": {
		"psr-4": {
			"OCA\\BoudicaAi\\": "lib/"
		}
	},
	"scripts": {
		"post-install-cmd": [
			"@composer bin all install --ansi"
		],
		"post-update-cmd": [
			"@composer bin all install --ansi"
		],
		"lint": "find . -name \\*.php -not -path './vendor/*' -not -path './vendor-bin/*' -not -path './build/*' -print0 | xargs -0 -n1 php -l",
		"cs:check": "php-cs-fixer fix --dry-run --diff",
		"cs:fix": "php-cs-fixer fix",
		"psalm": "psalm --threads=1 --no-cache",
		"test:unit": "phpunit tests -c tests/phpunit.xml --colors=always --fail-on-warning --fail-on-risky",
		"openapi": "generate-spec",
		"rector": "rector && composer cs:fix"
	},
	"require": {
		"bamarni/composer-bin-plugin": "^1.8",
		"php": "^8.1"
	},
	"require-dev": {
		"nextcloud/ocp": "dev-stable31",
		"roave/security-advisories": "dev-latest"
	},
	"config": {
		"allow-plugins": {
			"bamarni/composer-bin-plugin": true
		},
		"optimize-autoloader": true,
		"sort-packages": true,
		"platform": {
			"php": "8.1"
		}
	}
}
