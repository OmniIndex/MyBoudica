# Gambia sovereign MyBoudica (setup.sh sites/gambia).
SITE_NAME=gambia
SITE_TITLE="MyBoudica Gambia"
SITE_SLOGAN="The Smiling Coast of Africa"
# Flag blue, as on the Ask Gambia site (content/sovereign_ai/gambia).
SITE_COLOR="#0c1c8c"
SITE_BACKGROUND_COLOR="#070f4d"
# Only accounts of this domain may sign in.
SITE_ACCOUNT_DOMAIN=gambia.myboudica.com
SITE_URL=https://gambia.myboudica.com/
# The login background is a CC BY 4.0 photo (Sunrise at the Gambia River in
# Banjul, Forbes Johnston, Wikimedia Commons): the credit must stay reachable.
# The Ask Gambia about page lists every photo credit.
SITE_IMPRINT_URL=https://gambia.myboudica.com/about.html
SITE_DEFAULT_APP=dashboard
# Second sovereign site on a box that already runs Bangladesh (sov-*): its
# own service names (gm-nextcloud, ...) and compose project (myboudica-gm).
SITE_SERVICE_PREFIX=gm
