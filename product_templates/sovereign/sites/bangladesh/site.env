# Bangladesh sovereign MyBoudica (setup.sh sites/bangladesh).
SITE_NAME=bangladesh
SITE_TITLE="MyBoudica Bangladesh"
SITE_SLOGAN="Beautiful Bangladesh"
# Flag green, as on the Ask Bangladesh site (content/sovereign_ai/bangladesh).
SITE_COLOR="#006a4e"
SITE_BACKGROUND_COLOR="#00402f"
# Only accounts of this domain may sign in.
SITE_ACCOUNT_DOMAIN=bangladesh.myboudica.com
SITE_URL=https://bangladesh.myboudica.com/
# The login background is a CC BY-SA photo (Ratargul swamp forest,
# Abdulmominbd, Wikimedia Commons): the credit must stay reachable. The
# Ask Bangladesh about page lists every photo credit.
SITE_IMPRINT_URL=https://bangladesh.myboudica.com/about.html
SITE_DEFAULT_APP=dashboard
